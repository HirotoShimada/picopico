# Copy to backend/.env and adjust. Never commit real keys (backend/.env is git-ignored).
# Relative directory paths are resolved against the backend/ directory.

# --- Infrastructure ------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://mvf:mvf@127.0.0.1:5432/mvf
# DATABASE_URL=sqlite:///./var/mvf.sqlite3
REDIS_URL=redis://127.0.0.1:6379/0
# inline = thread pool inside the API process (no Redis needed); celery = Celery workers
TASK_MODE=inline

# --- Storage -------------------------------------------------------------------
# local | s3
STORAGE_BACKEND=local
STORAGE_DIR=var/storage
WORK_DIR=var/work
# S3 / S3-compatible (MinIO, Cloudflare R2, ...) when STORAGE_BACKEND=s3
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=

# --- HTTP ----------------------------------------------------------------------
# Base of the absolute signed media URLs returned by the API
PUBLIC_API_BASE_URL=http://localhost:8000
# Comma-separated browser origins allowed by CORS
CORS_ORIGINS=http://localhost:3000

# --- Auth & signing ---------------------------------------------------------------
# dev = single local user without token; token = "Authorization: Bearer <token>" required
AUTH_MODE=dev
# token mode only: comma-separated name:token pairs (tokens >= 16 random chars), e.g.
# API_TOKENS=alice:<random-token>,bob:<random-token>
API_TOKENS=
# HMAC key for signed media URLs. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
# If empty, a random per-process key is used (URLs break on restart / across processes).
SECRET_KEY=
MEDIA_URL_TTL=3600

# --- Upload limits (MB) --------------------------------------------------------------
MAX_AUDIO_MB=100
MAX_VIDEO_MB=500

# --- AI services (read server-side only, never returned by the API) ----------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Kling: current API uses KLING_API_KEY; ACCESS/SECRET keys are for the legacy API
KLING_API_KEY=
KLING_ACCESS_KEY=
KLING_SECRET_KEY=
KLING_API_BASE=https://api-singapore.klingai.com
RUNWAY_API_KEY=
RUNWAY_API_BASE=https://api.dev.runwayml.com
# Gemini API key (Veo via the Gemini API)
GOOGLE_API_KEY=

# --- Generation defaults ---------------------------------------------------------------
DEFAULT_BUDGET_USD=50
WHISPER_MODEL=small
# Optional extra fonts directory for libass subtitle rendering
FONTS_DIR=
